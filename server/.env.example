# ─────────────────────────────────────────────────────────────────────────────
# Bluetick — Server Environment Variables Template
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Frontend URL (CORS whitelist) ───────────────────────────────────────────
# Your production frontend domain. No trailing slash.
FRONTEND_URL=https://yourdomain.com

# ─── Public API URL ──────────────────────────────────────────────────────────
# Used by background callbacks (PhonePe, media storage, internal links).
VITE_API_URL=https://api.yourdomain.com

# ─── Domain Configuration ────────────────────────────────────────────────────
# Change ONLY these three values when moving to a new domain.
# No code changes are needed — everything reads from here.

# The root platform domain (no protocol, no trailing slash, no www).
# Subdomains (www, staging, api, etc.) are matched automatically.
PLATFORM_DOMAIN=yourdomain.com

# The CNAME/A-record target that merchant store owners must point their
# custom domains to. Typically a subdomain on your main server.
ROUTER_HOSTNAME=router.yourdomain.com

# (Optional) Your server's direct IPv4 address — used as a fallback during
# merchant custom-domain DNS verification when CNAME resolution fails.
SERVER_IP=

# The CDN subdomain where uploaded media files are stored.
# Used by the image resize proxy to allow/block image source URLs.
CDN_HOST=cdn.yourdomain.com

# ─── Dual-Domain / Migration Support (Optional) ──────────────────────────────
# Comma-separated secondary platform domains. Each domain and ALL its subdomains
# (e.g. www, staging, api) are automatically allowed through CORS.
# Perfect when running two frontends in parallel during migration (e.g. bluetick.cloud + onedash.cloud).
EXTRA_PLATFORM_DOMAINS=onedash.cloud

# Comma-separated list of exact additional origins (protocol + host) to allow in CORS.
# EXTRA_CORS_ORIGINS=https://onedash.cloud,https://staging.onedash.cloud

# ─── Cloudflare for SaaS (Custom Store Domains) ──────────────────────────────
# Required for auto-provisioning SSL certificates for merchant custom domains.
# Zone ID from Cloudflare Dashboard → Overview (right sidebar).
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# API token with "Zone.Custom Hostnames: Edit" permissions: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
DB_NAME=whatsapp_saas
DB_USER=bluetick_user
DB_PASS=YourStrongPasswordHere
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Auth Secret ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ─── Webhook Security Token ──────────────────────────────────────────────────
# This MUST match the "Verify Token" entered in your Meta Developer Dashboard.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_32_CHAR_HEX

# ─── Meta / Facebook App ─────────────────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App → Settings → Basic
FB_CLIENT_ID=your_facebook_app_id
FB_CLIENT_SECRET=your_facebook_app_secret

# ─── WhatsApp Phone Number Registration PIN ───────────────────────────────────
# A 6-digit fallback PIN used when registering a phone number on the Cloud API
# via POST /{phone-number-id}/register (required for Tech Providers / Embedded Signup).
# In practice, Bluetick derives the PIN per-customer from the last 6 digits of
# their WhatsApp Business phone number (unique, deterministic, no extra storage).
# This env var is only used if the display phone number is unavailable at signup time.
# Generate a random value: node -e "console.log(Math.floor(100000 + Math.random() * 900000))"
# NEVER use 000000 or 123456 — set a real random 6-digit number.
WA_REGISTRATION_PIN=REPLACE_WITH_RANDOM_6_DIGITS

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
