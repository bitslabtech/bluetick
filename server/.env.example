# ─────────────────────────────────────────────────────────────────────────────
# OneDash (Bluetick) — Server Environment Variables Template
# Copy this file to .env and fill in the values before starting the server.
# In production, set the same variables in Coolify instead of a .env file.
# NEVER commit the real .env file to version control.
#
# REQUIRED    = the server or a core feature will not work without it.
# RECOMMENDED = works without it, but production should set it.
# OPTIONAL    = safe to leave unset; the default or fallback is described.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# REQUIRED. Set to true once the first-run setup wizard (/setup) is complete.
# The wizard writes this itself; until it is "true" every request is sent to setup.
SETUP_COMPLETE=true

# ─── URLs ────────────────────────────────────────────────────────────────────
# REQUIRED. Your web app domain, no trailing slash. Used for CORS, emails and links.
FRONTEND_URL=https://yourdomain.com
# REQUIRED. Public URL of this API server. Used by payment callbacks (PhonePe),
# media URLs and internal links.
VITE_API_URL=https://api.yourdomain.com
# OPTIONAL fallbacks, only read when VITE_API_URL is empty. Leave unset normally.
# API_BASE_URL=https://api.yourdomain.com
# APP_URL=https://api.yourdomain.com
# OPTIONAL. Base URL for generated store / sitemap links. Default: the incoming request's host.
# BASE_URL=https://yourdomain.com

# ─── Domain Configuration ────────────────────────────────────────────────────
# Change ONLY these values when moving to a new domain. No code changes needed.

# REQUIRED. Root platform domain (no protocol, no trailing slash, no www).
# Subdomains (www, staging, api, ...) are matched automatically.
PLATFORM_DOMAIN=yourdomain.com

# REQUIRED for custom store domains. CNAME/A-record target merchants point their domains to.
ROUTER_HOSTNAME=router.yourdomain.com

# OPTIONAL. This server's public IPv4, used as a fallback during custom-domain DNS checks.
SERVER_IP=

# REQUIRED if media is served from a CDN subdomain. Used by the image resize proxy allow-list.
CDN_HOST=cdn.yourdomain.com
# OPTIONAL. Comma-separated older CDN hosts still allowed by the image proxy after a migration.
# LEGACY_CDN_HOSTS=cdn.olddomain.com
# OPTIONAL. Disk cache folder for resized images. Default: /tmp/imgcache
# IMG_CACHE_DIR=/tmp/imgcache

# ─── Dual-Domain / Migration Support (OPTIONAL) ──────────────────────────────
# Comma-separated secondary platform domains. Each domain and ALL its subdomains are
# allowed through CORS (e.g. running bluetick.cloud and onedash.cloud side by side).
EXTRA_PLATFORM_DOMAINS=onedash.cloud
# Comma-separated exact extra origins (protocol + host) to allow in CORS.
# EXTRA_CORS_ORIGINS=https://onedash.cloud,https://staging.onedash.cloud

# ─── Cloudflare for SaaS (Custom Store Domains) ──────────────────────────────
# REQUIRED for auto-provisioning SSL for merchant custom domains.
# Zone ID: Cloudflare Dashboard → Overview (right sidebar).
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# API token with "Zone.Custom Hostnames: Edit": https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ─── PostgreSQL Database (REQUIRED) ──────────────────────────────────────────
DB_NAME=whatsapp_saas
DB_USER=bluetick_user
DB_PASS=YourStrongPasswordHere
DB_HOST=localhost
# Note: the server currently always connects on PostgreSQL's default port 5432.
# DB_PORT is saved by the setup wizard but not read by config/database.js.
DB_PORT=5432

# ─── Redis (OPTIONAL) ────────────────────────────────────────────────────────
# Shared store for rate limiting. Without it, limits are kept in memory per server
# process (fine for one instance; set it when running more than one).
# REDIS_URL=redis://default:password@redis-host:6379

# ─── Secrets ─────────────────────────────────────────────────────────────────
# REQUIRED. Signs login tokens. Changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# RECOMMENDED. Encrypts WhatsApp / Meta access tokens at rest (utils/secretBox.js).
# Kept separate from JWT_SECRET on purpose. Without it, tokens are stored as plain text.
# Generate once: openssl rand -hex 32 — and keep a copy somewhere safe (password manager).
# On every start the server encrypts any tokens still stored as plain text (logged as
# "[SECRETS] Encrypted N stored access token(s)"), so turning it on = set the key + redeploy.
# Once set, NEVER change or lose this value, or every customer's WhatsApp connection becomes
# unreadable and must be reconnected. To change it, decrypt first with the OLD key
# (scripts/encryptTokens.js --decrypt --apply, kept locally, not deployed).
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# OPTIONAL (legacy). Encrypts the Meta Ads token (User.metaAdsToken). If unset it falls back
# to JWT_SECRET. If your server already runs WITHOUT it, do not add it now: existing
# Meta Ads connections were encrypted with JWT_SECRET and would stop working.
# ENCRYPTION_KEY=

# ─── Meta / Facebook App (REQUIRED) ──────────────────────────────────────────
# From https://developers.facebook.com → Your App → Settings → Basic
FB_CLIENT_ID=your_facebook_app_id
FB_CLIENT_SECRET=your_facebook_app_secret

# Must match the "Verify Token" set for the webhook in the Meta Developer Dashboard.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_32_CHAR_HEX

# OPTIONAL. Graph API versions. Defaults: v22.0 (most calls) and v25.0 (usage / pricing).
# META_GRAPH_API_VERSION=v22.0
# META_GRAPH_VERSION=v25.0

# ─── WhatsApp Phone Number Registration PIN ──────────────────────────────────
# Fallback 6-digit PIN for POST /{phone-number-id}/register (Embedded Signup).
# Normally the PIN is derived per customer from the last 6 digits of their business number;
# this is only used when that number is unavailable at signup time.
# Generate: node -e "console.log(Math.floor(100000 + Math.random() * 900000))"
# NEVER use 000000 or 123456.
WA_REGISTRATION_PIN=REPLACE_WITH_RANDOM_6_DIGITS

# ─── Google Gemini AI (REQUIRED for AI features) ─────────────────────────────
# From https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Cloudflare Turnstile (RECOMMENDED in production) ────────────────────────
# Bot protection on sign-up and login. Without it the captcha check is SKIPPED.
# Cloudflare Dashboard → Turnstile → your site → Secret key
TURNSTILE_SECRET_KEY=

# ─── Payments (OPTIONAL) ─────────────────────────────────────────────────────
# Payment gateways are normally configured in Superadmin → Settings → Payments.
# These are only a fallback for Razorpay when nothing is set there.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ─── Mobile app push for voice calls ─────────────────────────────────────────
# REQUIRED for WhatsApp voice calls on Android: Firebase service account JSON
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# Paste the whole JSON on one line, OR point to the file with FCM_SERVICE_ACCOUNT_PATH.
# NEVER commit this file or value.
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# REQUIRED for WhatsApp voice calls on iOS (VoIP push via APNs).
# Apple Developer → Certificates, IDs & Profiles → Keys → create a key with APNs enabled (.p8).
# Paste the .p8 contents (line breaks as \n) OR point to the file with APNS_KEY_PATH.
APNS_KEY=
# APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
# The iOS app's bundle identifier.
APNS_BUNDLE_ID=cloud.onedash.app
# true for App Store / TestFlight builds, false (or unset) for development builds.
APNS_PRODUCTION=true

# ─── TURN relay for voice calls (OFF for now) ────────────────────────────────
# Leave TURN_ENABLED unset: phones use public STUN only, nothing is relayed or billed.
# Turn on only if calls connect without audio on some networks
# (see onedash-app/docs/LAUNCH_READINESS.md, section 7).
# TURN_ENABLED=true
# Either Cloudflare TURN:
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Or any other TURN provider:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ─── Written by the setup wizard (not read directly by the server) ───────────
# Email uses the SMTP settings saved in Superadmin → Settings; the wizard also writes
# them here for reference.
# APP_NAME=OneDash
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=OneDash
