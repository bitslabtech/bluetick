# ─────────────────────────────────────────────────────────────────────────────
# Bluetick / OneDash — Frontend Environment Variables Template
# Pass these as Build Arguments (or in client .env) in Coolify or your build system.
# Note: Any changes to VITE_* variables require a full container rebuild/redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# Public backend API endpoint
# During migration, the new frontend can continue pointing to the shared backend:
# e.g., https://api.bluetick.cloud or https://api.onedash.cloud
VITE_API_URL=https://api.yourdomain.com

# Cloudflare Turnstile CAPTCHA (Site Key)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Meta / Facebook Embedded Signup
VITE_FB_APP_ID=your_facebook_app_id
VITE_FB_CONFIG_ID=your_facebook_config_id

# ── Domain Configuration ──────────────────────────────────────────────────────
# The platform domain for this frontend instance (no protocol, no trailing slash).
# Used by storeRouting.js to distinguish the SaaS platform from merchant stores.
# All subdomains (e.g. staging.yourdomain.com, www.yourdomain.com) are recognized automatically.
VITE_PLATFORM_DOMAIN=yourdomain.com

# The CNAME target shown to merchants in the WaStore custom domain settings UI.
VITE_ROUTER_HOSTNAME=router.yourdomain.com
